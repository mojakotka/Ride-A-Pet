local function triggerEggPickup(egg)

    if not egg
        or not egg.core
        or not egg.core.Parent then

        return false
    end

    if type(keypress)
        ~= "function"
        or type(keyrelease)
        ~= "function" then

        notify(
            AUTO_FARM_TAB_NAME,
            "keypress/keyrelease is not available",
            3,
            10
        )

        return false
    end

    local success =
        pcall(function()

            keypress(0x45)

            task.wait(2)

            keyrelease(0x45)

        end)

    return success
end

--==================================================
-- CHECK EXACT TARGET EGG
--==================================================

local function isEggPickedUp(originalEgg)

    if not originalEgg then
        return true
    end

    local originalObject =
        originalEgg.object

    if not originalObject then
        return true
    end

    local parent = nil

    pcall(function()
        parent = originalObject.Parent
    end)

    if not parent then
        return true
    end

    local renderedEggs = nil

    pcall(function()

        renderedEggs =
            Workspace:FindFirstChild(
                "RenderedEggs"
            )

    end)

    if not renderedEggs then
        return false
    end

    local stillInside = false

    pcall(function()

        stillInside =
            originalObject:IsDescendantOf(
                renderedEggs
            )

    end)

    if not stillInside then
        return true
    end

    return false
end

--==================================================
-- WAIT FOR EXACT EGG TO DISAPPEAR
--==================================================

local function waitForEggPickup(
    originalEgg
)

    local startedAt =
        tick()

    while autoFarm
        and overlayState.active
        and (
            tick()
            - startedAt
        ) < AUTO_FARM_PICKUP_CHECK_TIME do

        if isEggPickedUp(
            originalEgg
        ) then

            return true

        end

        task.wait(
            AUTO_FARM_PICKUP_CHECK_INTERVAL
        )

    end

    return isEggPickedUp(
        originalEgg
    )
end

