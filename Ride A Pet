--==================================================
-- WAYPOINT
--==================================================

local function tweenToPlotWaypoint()

    local character =
        LP.Character

    local root =
        character
        and (
            character:FindFirstChild(
                "HumanoidRootPart"
            )
            or character:FindFirstChild(
                "RootPart"
            )
            or character.PrimaryPart
        )

    if not root
        or not root:IsA(
            "BasePart"
        )
        or not plotWaypointPosition then

        return false
    end

    waypointTravelToken =
        waypointTravelToken + 1

    local travelToken =
        waypointTravelToken

    waypointTravelActive = true

    local targetCFrame =
        CFrame.new(
            plotWaypointPosition.X,
            plotWaypointPosition.Y + 3,
            plotWaypointPosition.Z
        )

    local startCFrame =
        root.CFrame

    local distance =
        (
            root.Position
            - targetCFrame.Position
        ).Magnitude

    local duration =
        math.clamp(
            distance
                / waypointTweenSpeed,
            0.25,
            12
        )

    local startedAt =
        tick()

    while overlayState.active
        and root.Parent
        and travelToken
            == waypointTravelToken do

        local alpha =
            math.clamp(
                (
                    tick()
                    - startedAt
                )
                / duration,
                0,
                1
            )

        pcall(function()

            root.CFrame =
                startCFrame:Lerp(
                    targetCFrame,
                    alpha
                )

            root.AssemblyLinearVelocity =
                Vector3.zero

            root.AssemblyAngularVelocity =
                Vector3.zero

        end)

        if alpha >= 1 then
            break
        end

        task.wait()

    end

    if travelToken
        == waypointTravelToken then

        waypointTravelActive = false

    end

    return true
end

