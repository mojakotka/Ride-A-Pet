--==================================================
-- CHANCE INDEX
--==================================================
--
-- IMPORTANT:
--
-- The Combo callback is ZERO-BASED.
--
-- 0  -> chanceTiers[1]  -> 0
-- 1  -> chanceTiers[2]  -> 5
-- 2  -> chanceTiers[3]  -> 30
-- 3  -> chanceTiers[4]  -> 100
-- 4  -> chanceTiers[5]  -> 500
-- 5  -> chanceTiers[6]  -> 1K
-- 6  -> chanceTiers[7]  -> 10K
-- 7  -> chanceTiers[8]  -> 100K
-- 8  -> chanceTiers[9]  -> 1M
-- 9  -> chanceTiers[10] -> 10M
-- 10 -> chanceTiers[11] -> 1B
-- 11 -> chanceTiers[12] -> 100B
-- 12 -> chanceTiers[13] -> 1T
--
-- Therefore the callback index MUST have +1
-- before accessing chanceTiers.
--
-- This fixes the bug where selecting 1B could
-- internally become 10M and allow 300M eggs.

local function getChanceIndexFromCombo(index)

    local comboIndex =
        tonumber(index)

    if comboIndex == nil then
        comboIndex = 0
    end

    comboIndex =
        math.floor(
            comboIndex
        )

    if comboIndex < 0 then
        comboIndex = 0
    end

    local selectedIndex =
        comboIndex + 1

    if selectedIndex < 1 then
        selectedIndex = 1
    end

    if selectedIndex > #chanceTiers then
        selectedIndex = #chanceTiers
    end

    return selectedIndex
end

