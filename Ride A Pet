--==================================================
-- FIND BEST TARGET
--==================================================

local function findBestAutoFarmTarget()

    local container =
        Workspace:FindFirstChild(
            "RenderedEggs"
        )

    if not container then
        return nil
    end

    local bestEgg = nil
    local bestChance = -1

    local children =
        container:GetChildren()

    for i = 1, #children do

        local obj =
            children[i]

        if obj:IsA("Model") then

            local egg =
                getCachedNode(obj)

            if egg
                and isEligibleAutoFarmTarget(
                    egg
                )
                and egg.chance > bestChance then

                bestChance =
                    egg.chance

                bestEgg =
                    egg

            end

        end

    end

    return bestEgg
end

