-- JUMP TO BEST TIER
--==================================================

local function jumpToTopTier()

    local container =
        Workspace:FindFirstChild(
            "RenderedEggs"
        )

    if not container then

        notify(
            TAB_NAME,
            "RenderedEggs not found",
            3,
            10
        )

        return
    end

    local primeTarget = nil
    local maxChance = -1

    local children =
        container:GetChildren()

    for i = 1, #children do

        local obj =
            children[i]

        if obj:IsA("Model") then

            local parsed =
                getCachedNode(obj)

            if parsed
                and parsed.chance > maxChance then

                maxChance =
                    parsed.chance

                primeTarget =
                    parsed

            end

        end

    end

    if not primeTarget then

        notify(
            TAB_NAME,
            "No egg target found",
            3,
            10
        )

        return
    end

    local avatar =
        LP.Character

    if not avatar
        or not primeTarget.core
        or not primeTarget.core.Parent then

        notify(
            TAB_NAME,
            "Target is no longer available",
            3,
            10
        )

        return
    end

    local pos =
        primeTarget.core.Position

    local newCF =
        CFrame.new(
            pos.X,
            pos.Y + 2.5,
            pos.Z
        )

    local pivoted =
        pcall(function()

            avatar:PivotTo(
                newCF
            )

        end)

    if not pivoted then

        local root =
            avatar:FindFirstChild(
                "HumanoidRootPart"
            )
            or avatar.PrimaryPart

        if root then
            root.CFrame = newCF
        end

    end

    notify(
        TAB_NAME,
        "Jumped to "
            .. primeTarget.identity
            .. " | "
            .. primeTarget.tier
            .. " | Chance "
            .. encodeSuffix(
                primeTarget.chance
            ),
        3,
        10
    )
end

