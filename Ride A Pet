local function notify(
    title,
    message,
    duration,
    position
)

    title =
        tostring(
            title
            or "Notification"
        )

    message =
        tostring(
            message
            or ""
        )

    duration =
        tonumber(duration)
        or 3

    if externalNotify then

        pcall(function()

            externalNotify(
                title,
                message,
                duration,
                position
            )

        end)

        return
    end

    task.spawn(function()

        for i = 1, 5 do

            local success =
                pcall(function()

                    StarterGui:SetCore(
                        "SendNotification",
                        {
                            Title = title,
                            Text = message,
                            Duration = duration
                        }
                    )

                end)

            if success then
                return
            end

            task.wait(0.25)

        end

    end)

end

--==================================================
-- CHANCE PARSER
--==================================================

local function decodeSuffix(text)

    if text == nil then
        return nil
    end

    local raw =
        tostring(text)
        :upper()
        :gsub(",", "")
        :gsub("%s+", "")

    local baseNum, suffix =
        raw:match(
            "^([%d%.]+)([KMBTQ]?)$"
        )

    local finalNum =
        tonumber(baseNum)

    if not finalNum then
        return nil
    end

    local multipliers = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12,
        Q = 1e15,
    }

    return finalNum *
        (
            multipliers[suffix]
            or 1
        )
end

--==================================================
-- RESOLVE TIER
--==================================================

local function resolveTier(chance)

    if chance >= 1e11 then
        return "Ethereal"
    end

    if chance >= 3e8 then
        return "Divine"
    end

    if chance >= 9e4 then
        return "Mythic"
    end

    if chance >= 1e4 then
        return "Legendary"
    end

    if chance >= 500 then
        return "Epic"
    end

    if chance >= 30 then
        return "Rare"
    end

    return "Common"
end

--==================================================
-- FIND EGG CORE
--==================================================

local function findEggCore(node)

    if not node then
        return nil
    end

    local core =
        node:FindFirstChild("Handle")

    if core
        and core:IsA("BasePart") then

        return core
    end

    core =
        node:FindFirstChild("RootPart")

    if core
        and core:IsA("BasePart") then

        return core
    end

    core =
        node:FindFirstChild("EggBase")

    if core
        and core:IsA("BasePart") then

        return core
    end

    core =
        node.PrimaryPart

    if core
        and core:IsA("BasePart") then

        return core
    end

    return node:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

--==================================================
-- FIND CHANCE TEXT
--==================================================

local function findChanceText(
    node,
    core
)

    local ui =
        core
        and core:FindFirstChild(
            "EggLuck"
        )

    if not ui then

        ui =
            node:FindFirstChild(
                "EggLuck"
            )

    end

    if ui then

        local luck =
            ui:FindFirstChild(
                "Luck"
            )

        if luck
            and (
                luck:IsA("TextLabel")
                or luck:IsA("TextButton")
                or luck:IsA("TextBox")
            ) then

            return luck

        end

    end

    local descendants =
        node:GetDescendants()

    for i = 1, #descendants do

        local object =
            descendants[i]

        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then

            local parsed =
                decodeSuffix(
                    object.Text
                )

            if parsed then
                return object
            end

        end

    end

    return nil
end

--==================================================
-- EXTRACT EGG DATA
--==================================================

local function extractNodeData(node)

    if not node then
        return nil
    end

    local core =
        findEggCore(node)

    if not core then
        return nil
    end

    local textUI =
        findChanceText(
            node,
            core
        )

    if not textUI then
        return nil
    end

    local chanceVal =
        decodeSuffix(
            textUI.Text
        )

    if not chanceVal then
        return nil
    end

    local tier =
        resolveTier(
            chanceVal
        )

    return {

        object = node,

        core = core,

        identity = node.Name,

        chance = chanceVal,

        tier = tier,

        tierRank =
            tierRank[tier]
            or 0,

        color =
            tierColors[tier]
            or Color3.new(
                1,
                1,
                1
            ),
    }
end

--==================================================
-- NODE CACHE
--==================================================

local function getCachedNode(node)

    if not node then
        return nil
    end

    local cached =
        nodeCache[node]

    if cached
        and cached.object
        and cached.object.Parent
        and cached.core
        and cached.core.Parent then

        return cached

    end

    local parsed =
        extractNodeData(
            node
        )

    if parsed then

        nodeCache[node] =
            parsed

        return parsed

    end

    nodeCache[node] = false

    return nil
end

--==================================================
-- CLEAR DEAD CACHE
--==================================================

local function cleanNodeCache()

    for object, data in pairs(
        nodeCache
    ) do

        if object == nil
            or not object.Parent
            or (
                data
                and (
                    not data.core
                    or not data.core.Parent
                )
            ) then

            nodeCache[object] = nil

        end

    end

end

--==================================================
-- TRACKING FILTER
--==================================================

local function validateNode(data)

    if not data then
        return false
    end

    if not overlayState.showVisuals then
        return false
    end

    local minChance =
        overlayState.trackingMinChance

    if data.chance < minChance then
        return false
    end

    local chosenTier =
        tierOrder[
            overlayState.tierIndex
        ]
        or "All"

    if chosenTier == "All" then
        return true
    end

    local minRank =
        tierRank[chosenTier]
        or 0

    return data.tierRank >= minRank
end

--==================================================
-- AUTO FARM FILTER
--==================================================

local function isEligibleAutoFarmTarget(data)

    if not data then
        return false
    end

    return data.chance >= autoFarmMinChance
end

--==================================================
-- RESTORE MOVEMENT
--==================================================

local originalCollisions = {}
local platformStandHumanoid = nil

local function restoreMovementState()

    if ghostConn then
        ghostConn:Disconnect()
        ghostConn = nil
    end

    for part, canCollide in pairs(
        originalCollisions
    ) do

        if part
            and part.Parent then

            pcall(function()

                part.CanCollide =
                    canCollide

            end)

        end

    end

    table.clear(
        originalCollisions
    )

    if platformStandHumanoid
        and platformStandHumanoid.Parent then

        pcall(function()

            platformStandHumanoid.PlatformStand =
                false

        end)

    end

    platformStandHumanoid = nil
end

--==================================================
-- GHOSTING
--==================================================

local function applyGhosting()

    local avatar =
        LP.Character

    if not avatar then
        return
    end

    for _, piece in ipairs(
        avatar:GetDescendants()
    ) do

        if piece:IsA(
            "BasePart"
        ) then

            if originalCollisions[piece] == nil then

                originalCollisions[piece] =
                    piece.CanCollide

            end

            piece.CanCollide = false

        end

    end
end

--==================================================
-- SUBMERGE
--==================================================

local function submergeCharacter()

    local avatar =
        LP.Character

    if not avatar then

        notify(
            TAB_NAME,
            "Character not found",
            3,
            10
        )

        return
    end

    local root =
        avatar:FindFirstChild(
            "HumanoidRootPart"
        )
        or avatar.PrimaryPart

    local hum =
        avatar:FindFirstChildOfClass(
            "Humanoid"
        )

    if not root
        or (
            hum
            and hum.Health <= 0
        ) then

        notify(
            TAB_NAME,
            "Character root not found",
            3,
            10
        )

        return
    end

    if glideConn then
        glideConn:Disconnect()
        glideConn = nil
    end

    restoreMovementState()

    local originCF =
        root.CFrame

    local destCF =
        CFrame.new(
            originCF.Position.X,
            originCF.Position.Y
                - movementConfig.submergeDepth,
            originCF.Position.Z
        )

    local timeToGlide =
        math.clamp(
            movementConfig.submergeDepth
                / movementConfig.glideSpeed,
            0.1,
            2
        )

    local startTick =
        tick()

    ghostConn =
        RunService.Stepped:Connect(
            applyGhosting
        )

    platformStandHumanoid =
        hum

    if hum then

        pcall(function()
            hum.PlatformStand = true
        end)

    end

    glideConn =
        RunService.RenderStepped:Connect(
            function()

                if not root.Parent then

                    if glideConn then
                        glideConn:Disconnect()
                        glideConn = nil
                    end

                    restoreMovementState()

                    return
                end

                local progress =
                    math.clamp(
                        (
                            tick()
                            - startTick
                        )
                        / timeToGlide,
                        0,
                        1
                    )

                pcall(function()

                    root.CFrame =
                        originCF:Lerp(
                            destCF,
                            progress
                        )

                    root.AssemblyLinearVelocity =
                        Vector3.zero

                    root.AssemblyAngularVelocity =
                        Vector3.zero

                end)

                if progress >= 1 then

                    if glideConn then
                        glideConn:Disconnect()
                        glideConn = nil
                    end

                    notify(
                        TAB_NAME,
                        "Shifted underground",
                        2,
                        10
                    )

                    task.delay(
                        movementConfig.ghostTime,
                        function()

                            if overlayState.active
                                and not glideConn then

                                restoreMovementState()

                            end

                        end
                    )

                end

            end
        )
end

