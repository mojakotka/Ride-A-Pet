_G.RidePetOverlay_Unload =
    function()

        overlayState.active =
            false

        autoFarm =
            false

        autoFarmActionBusy =
            false

        releaseAutoFarmAirHold()

        waypointTravelToken =
            waypointTravelToken + 1

        if inputBlock then
            inputBlock:Disconnect()
            inputBlock = nil
        end

        if glideConn then
            glideConn:Disconnect()
            glideConn = nil
        end

        restoreMovementState()

        if renderTick then
            renderTick:Disconnect()
            renderTick = nil
        end

        for i = 1, MAX_NODES do

            if labelCache[i] then

                pcall(function()
                    labelCache[i]:Remove()
                end)

            end

        end

        table.clear(
            nodeCache
        )

        table.clear(
            activeNodes
        )

        activeNodeCount = 0

        pcall(function()

            UI.RemoveTab(
                TAB_NAME
            )

        end)

        pcall(function()

            UI.RemoveTab(
                AUTO_FARM_TAB_NAME
            )

        end)

        _G.RidePetOverlay_Unload =
            nil

    end

--==================================================
-- AUTO FARM LOOP
--==================================================

task.spawn(
    function()

        local nextScan = 0
        local cachedBestEgg = nil

        while overlayState.active do

            if not autoFarm then

                cachedBestEgg = nil
                nextScan = 0

                releaseAutoFarmAirHold()

                task.wait(0.25)

            else

                local now =
                    tick()

                if not autoFarmActionBusy
                    and now >= nextScan then

                    cachedBestEgg =
                        findBestAutoFarmTarget()

                    nextScan =
                        now
                        + AUTO_FARM_SCAN_RATE

                end

                local character =
                    LP.Character

                local root =
                    character
                    and character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                local bestEgg =
                    cachedBestEgg

                if root
                    and bestEgg
                    and bestEgg.core
                    and bestEgg.core.Parent
                    and not autoFarmActionBusy then

                    autoFarmActionBusy =
                        true

                    local liveEgg =
                        getCachedNode(
                            bestEgg.object
                        )

                    if liveEgg
                        and isEligibleAutoFarmTarget(
                            liveEgg
                        )
                        and liveEgg.core
                        and liveEgg.core.Parent then

                        bestEgg =
                            liveEgg

                        local eggPos =
                            bestEgg.core.Position

                        root.CFrame =
                            CFrame.new(
                                eggPos.X,
                                eggPos.Y + 4,
                                eggPos.Z
                            )

                        setAutoFarmAirHold(true)

                        task.spawn(
                            function()

                                task.wait(
                                    autoFarmSecondTeleportDelay
                                )

                                if not autoFarm
                                    or not overlayState.active then

                                    releaseAutoFarmAirHold()

                                    autoFarmActionBusy =
                                        false

                                    return
                                end

                                local currentCharacter =
                                    LP.Character

                                local currentRoot =
                                    currentCharacter
                                    and currentCharacter:FindFirstChild(
                                        "HumanoidRootPart"
                                    )

                                -- Capture exact target once.
                                local currentEgg =
                                    bestEgg

                                if currentRoot
                                    and currentEgg
                                    and currentEgg.object
                                    and currentEgg.core
                                    and currentEgg.core.Parent then

                                    local secondEggPos =
                                        currentEgg.core.Position

                                    currentRoot.CFrame =
                                        CFrame.new(
                                            secondEggPos.X,
                                            secondEggPos.Y + 4,
                                            secondEggPos.Z
                                        )

                                    setAutoFarmAirHold(true)

                                    task.wait(
                                        autoFarmPickupDelay
                                    )

                                    if autoFarm
                                        and overlayState.active then

                                        local pickupStarted =
                                            triggerEggPickup(
                                                currentEgg
                                            )

                                        local pickupConfirmed =
                                            false

                                        if pickupStarted then

                                            pickupConfirmed =
                                                waitForEggPickup(
                                                    currentEgg
                                                )

                                        end

                                        if pickupConfirmed then

                                            releaseAutoFarmAirHold()

                                            task.wait(
                                                autoFarmPostPickupDelay
                                            )

                                            if autoFarm
                                                and overlayState.active then

                                                if plotWaypointPosition then

                                                    local returnedToPlot =
                                                        tweenToPlotWaypoint()

                                                    if returnedToPlot then

                                                        notify(
                                                            AUTO_FARM_TAB_NAME,
                                                            "Egg picked up - returning to waypoint",
                                                            2,
                                                            10
                                                        )

                                                    else

                                                        setAutoFarm(
                                                            false
                                                        )

                                                    end

                                                else

                                                    setAutoFarm(
                                                        false
                                                    )

                                                    notify(
                                                        AUTO_FARM_TAB_NAME,
                                                        "Auto Farm stopped: set a plot waypoint first",
                                                        3,
                                                        10
                                                    )

                                                end

                                            else

                                                releaseAutoFarmAirHold()

                                            end

                                        else

                                            -- Pickup failed.
                                            -- Do NOT return to waypoint.
                                            -- Rescan and retry.

                                            releaseAutoFarmAirHold()

                                            cachedBestEgg =
                                                nil

                                        end

                                    else

                                        releaseAutoFarmAirHold()

                                    end

                                else

                                    releaseAutoFarmAirHold()

                                    cachedBestEgg =
                                        nil

                                end

                                autoFarmActionBusy =
                                    false

                            end
                        )

                    else

                        releaseAutoFarmAirHold()

                        autoFarmActionBusy =
                            false

                        cachedBestEgg =
                            nil

                    end

                end

                task.wait(0.05)

            end

        end

        releaseAutoFarmAirHold()

    end
)

