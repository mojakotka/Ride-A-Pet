-- KEY INPUT
--==================================================

inputBlock =
    UIS.InputBegan:Connect(
        function(
            input,
            gameProcessed
        )

            local keyCode =
                input.KeyCode

            local isEnumKey =
                typeof(keyCode)
                == "EnumItem"

            local isNumericKey =
                type(keyCode)
                == "number"

            if not isEnumKey
                and not isNumericKey then

                return
            end

            if (
                isEnumKey
                and keyCode
                    == Enum.KeyCode.Unknown
            )
            or (
                isNumericKey
                and keyCode == 0
            ) then

                return
            end

            local keyName =
                isEnumKey
                and keyCode.Name
                or tostring(
                    keyCode
                )

            if awaitDiveKey then

                diveKey =
                    keyCode

                awaitDiveKey = false

                notify(
                    TAB_NAME,
                    "Submerge Key mapped to: "
                        .. keyName,
                    3,
                    10
                )

                return
            end

            if awaitTopTargetKey then

                topTargetKey =
                    keyCode

                awaitTopTargetKey = false

                notify(
                    TAB_NAME,
                    "Jump Key mapped to: "
                        .. keyName,
                    3,
                    10
                )

                return
            end

            if awaitAutoFarmKey then

                autoFarmKey =
                    keyCode

                awaitAutoFarmKey = false

                notify(
                    AUTO_FARM_TAB_NAME,
                    "Auto Farm key mapped to: "
                        .. keyName,
                    3,
                    10
                )

                return
            end

            if gameProcessed then
                return
            end

            if diveKey
                and keyCode == diveKey then

                submergeCharacter()

            end

            if topTargetKey
                and keyCode == topTargetKey then

                jumpToTopTier()

            end

            if autoFarmKey
                and keyCode == autoFarmKey then

                setAutoFarm(
                    not autoFarm
                )

            end

        end
    )

--==================================================
-- TRACKING SCAN LOOP
--==================================================

task.spawn(
    function()

        while overlayState.active do

            local incoming = {}
            local incomingCount = 0

            local env =
                Workspace:FindFirstChild(
                    "RenderedEggs"
                )

            if env then

                local children =
                    env:GetChildren()

                for i = 1, #children do

                    if incomingCount >= MAX_NODES then
                        break
                    end

                    local obj =
                        children[i]

                    if obj:IsA("Model") then

                        local parsed =
                            getCachedNode(
                                obj
                            )

                        if parsed then

                            incomingCount =
                                incomingCount + 1

                            incoming[
                                incomingCount
                            ] = parsed

                        end

                    end

                end

            end

            activeNodes =
                incoming

            activeNodeCount =
                incomingCount

            cleanNodeCache()

            task.wait(
                REFRESH_RATE
            )

        end

    end
)

--==================================================
-- ESP RENDER LOOP
--==================================================

local espAccumulator = 0

renderTick =
    RunService.RenderStepped:Connect(
        function(deltaTime)

            espAccumulator =
                espAccumulator
                + deltaTime

            if espAccumulator
                < ESP_REFRESH_RATE then

                return
            end

            espAccumulator = 0

            if not overlayState.showVisuals then

                for i = 1, MAX_NODES do

                    if labelCache[i].Visible then
                        labelCache[i].Visible = false
                    end

                end

                return
            end

            if type(
                WorldToScreen
            ) ~= "function" then

                for i = 1, MAX_NODES do
                    labelCache[i].Visible = false
                end

                return
            end

            local cam =
                Workspace.CurrentCamera

            if not cam then

                for i = 1, MAX_NODES do
                    labelCache[i].Visible = false
                end

                return
            end

            local cameraPosition =
                cam.CFrame.Position

            local maxDistance =
                overlayState.renderDistance

            local maxDistanceSquared =
                maxDistance
                * maxDistance

            local activeDraws = 0

            for i = 1, activeNodeCount do

                local node =
                    activeNodes[i]

                if node
                    and node.core
                    and node.core.Parent
                    and validateNode(node) then

                    local corePosition =
                        node.core.Position

                    local dx =
                        corePosition.X
                        - cameraPosition.X

                    local dy =
                        corePosition.Y
                        - cameraPosition.Y

                    local dz =
                        corePosition.Z
                        - cameraPosition.Z

                    local distanceSquared =
                        dx * dx
                        + dy * dy
                        + dz * dz

                    if distanceSquared
                        <= maxDistanceSquared then

                        local screenPosition = nil
                        local onScreen = false

                        local targetPosition =
                            corePosition
                            + Vector3.new(
                                0,
                                2.8,
                                0
                            )

                        pcall(function()

                            local a, b, c =
                                WorldToScreen(
                                    targetPosition
                                )

                            if typeof(a)
                                == "Vector2" then

                                screenPosition =
                                    a

                                onScreen =
                                    b ~= false

                                return
                            end

                            if type(a)
                                == "number"
                                and type(b)
                                    == "number" then

                                screenPosition =
                                    Vector2.new(
                                        a,
                                        b
                                    )

                                onScreen =
                                    c ~= false

                                return
                            end

                            if type(a)
                                == "table"
                                and a.X
                                and a.Y then

                                screenPosition =
                                    Vector2.new(
                                        a.X,
                                        a.Y
                                    )

                                onScreen =
                                    a.OnScreen
                                    ~= false

                            end

                        end)

                        if screenPosition
                            and onScreen
                            and activeDraws
                                < MAX_NODES then

                            activeDraws =
                                activeDraws + 1

                            local txtObj =
                                labelCache[
                                    activeDraws
                                ]

                            local fragments = {}

                            if overlayState.displayName then

                                fragments[
                                    #fragments + 1
                                ] =
                                    node.identity

                            end

                            if overlayState.displayTier then

                                fragments[
                                    #fragments + 1
                                ] =
                                    node.tier

                            end

                            if overlayState.displayChance then

                                fragments[
                                    #fragments + 1
                                ] =
                                    "Chance "
                                    .. encodeSuffix(
                                        node.chance
                                    )

                            end

                            local newText =
                                table.concat(
                                    fragments,
                                    " | "
                                )

                            if txtObj.Text
                                ~= newText then

                                txtObj.Text =
                                    newText

                            end

                            if txtObj.Position
                                ~= screenPosition then

                                txtObj.Position =
                                    screenPosition

                            end

                            if txtObj.Color
                                ~= node.color then

                                txtObj.Color =
                                    node.color

                            end

                            if not txtObj.Visible then
                                txtObj.Visible = true
                            end

                        end

                    end

                end

            end

            for i =
                activeDraws + 1,
                MAX_NODES do

                if labelCache[i].Visible then
                    labelCache[i].Visible = false
                end

            end

        end
    )

